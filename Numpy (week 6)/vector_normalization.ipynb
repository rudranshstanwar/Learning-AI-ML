   "cell_type": "code",
   "source": [
    "arr = np.array([[1, 2], [3, 4]])\n",
    "mean = np.mean(arr)\n",
    "std = np.std(arr)\n",
    "\n",
    "#normalise\n",
    "normalized_arr = (arr - mean) / std\n",
    "print(normalized_arr)\n",
    "print(np.mean(normalized_arr))\n",
    "print(np.std(normalized_arr))"
   ],
